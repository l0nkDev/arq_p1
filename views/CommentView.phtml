<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <title>Comentarios - Ticket #<?php echo $this->ticket['id']; ?></title>
</head>

<body>
    <div class="w-100 h-100 d-flex flex-column align-items-center gap-4 p-4 bg-light">
        <div class="card shadow-sm w-100" style="max-width: 800px;">
            <div class="card-body">
                <div class="d-flex flex-row align-items-center justify-content-between mb-3">
                    <h5 class="card-title mb-0">
                        Comentarios para: <?php echo htmlspecialchars($this->ticket["title"]); ?>
                    </h5>
                    <a href="/tickets" class="btn btn-outline-secondary">
                        ⬅️ Volver
                    </a>
                </div>

                <div class="alert alert-info p-2 mb-4">
                    <strong>Descripción:</strong> <?php echo htmlspecialchars($this->ticket["description"]); ?>
                </div>

                <h6>Dejar un comentario:</h6>
                <form action="/comments/create" method="POST" class="mb-4">
                    <input type="hidden" name="ticket_id" value="<?php echo $this->ticket['id']; ?>">
                    <div class="input-group">
                        <input type="text" name="text" class="form-control" placeholder="Escribe tu comentario (ej: no uses palabras como tonto)..." required>
                        <button class="btn btn-primary" type="submit">Enviar</button>
                    </div>
                </form>

                <hr>
                
                <h6>Comentarios Anteriores (<?php echo count($this->comments); ?>)</h6>
                <?php if (count($this->comments) === 0): ?>
                    <p class="text-muted small">No hay comentarios todavía.</p>
                <?php else: ?>
                    <ul class="list-group">
                        <?php foreach ($this->comments as $comment): ?>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted"><?php echo $comment['created_at']; ?></small><br>
                                    <?php echo htmlspecialchars($comment['text']); ?>
                                </div>
                                <a href="/comments/delete/<?php echo $comment['id']; ?>?ticket_id=<?php echo $this->ticket['id']; ?>" class="btn btn-sm btn-outline-danger" title="Eliminar">🗑️</a>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                <?php endif; ?>
            </div>
        </div>
    </div>
