<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <title>Gestión de Tickets</title>
</head>

<body>
    <div class="w-100 h-100 d-flex flex-column align-items-center gap-4 p-4 bg-light">
        <div class="card shadow-sm w-100" style="max-width: 1300px;">
            <div class="card-body">
                <div class="d-flex flex-row align-items-center justify-content-between mb-3">
                    <h5 class="card-title mb-0">Gestión de Tickets</h5>
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal"
                        data-bs-target="#createTicketModal">
                        ➕ Registrar Objeto
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle text-center mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Foto</th>
                                <th>Título</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php foreach ($data as $entry): ?>
                                <tr>
                                    <td class="fw-bold text-muted"><?php echo $entry["id"] ?></td>
                                    <td>
                                        <?php if ($entry["imageurl"]): ?>
                                            <img src="<?php echo $entry["imageurl"] ?>" class="rounded"
                                                style="height: 40px; width: 40px; object-fit: cover; border: 1px solid #ddd;">
                                        <?php else: ?>
                                            <span class="text-muted small">Sin foto</span>
                                        <?php endif ?>
                                    </td>
                                    <td class="fw-semibold"><?php echo htmlspecialchars($entry["title"]) ?></td>
                                    <td class="text-start"
                                        style="max-width: 200px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;"
                                        title="<?php echo htmlspecialchars($entry["description"]) ?>">
                                        <?php echo htmlspecialchars($entry["description"]) ?>
                                    </td>
                                    <td>
                                        <?php switch ($entry["status"]):
                                            case "5": ?>
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                                <?php break;
                                            case "4": ?>
                                                <span class="badge bg-info text-dark">Buscando</span>
                                                <?php break;
                                            case "3": ?>
                                                <span class="badge bg-success">Encontrado</span>
                                                <?php break;
                                            case "6": ?>
                                                <span class="badge bg-primary">Devuelto</span>
                                                <?php break;
                                            case "1": ?>
                                                <span class="badge bg-danger">Perdido</span>
                                                <?php break;
                                            case "2": ?>
                                                <span class="badge bg-secondary">Cerrado</span>
                                        <?php endswitch ?>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <form action="/tickets/update/<?php echo $entry["id"] ?>" method="POST"
                                                class="m-0">
                                                <input name="description"
                                                    value="<?php echo htmlspecialchars($entry["description"]) ?>" hidden>
                                                <div class="input-group input-group-sm" style="min-width: 140px;">
                                                    <select class="form-select" name="status">
                                                        <option <?php echo ($entry["status"] == "5") ? "selected" : "" ?> value="5">Pendiente</option>
                                                        <option <?php echo ($entry["status"] == "4") ? "selected" : "" ?> value="4">Buscando</option>
                                                        <option <?php echo ($entry["status"] == "3") ? "selected" : "" ?> value="3">Encontrado</option>
                                                        <option <?php echo ($entry["status"] == "6") ? "selected" : "" ?> value="6">Devuelto</option>
                                                        <option <?php echo ($entry["status"] == "1") ? "selected" : "" ?> value="1">Perdido</option>
                                                        <option <?php echo ($entry["status"] == "2") ? "selected" : "" ?> value="2">Cerrado</option>
                                                    </select>
                                                    <button class="btn btn-secondary" type="submit"
                                                        title="Guardar">💾</button> 
                                                        <a href="/comments/read/<?php echo $entry["id"] ?>" class="btn btn-outline-info btn-sm" title="Ver Comentarios">💬</a>
                                                        <a href="/tickets/delete/<?php echo $entry["id"] ?>" class="btn btn-outline-danger btn-sm" title="Eliminar Ticket">🗑️</a>
                                                </div>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <?php endforeach ?>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="modal fade" id="createTicketModal" tabindex="-1" aria-labelledby="createTicketModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="createTicketModalLabel">Registra un objeto perdido</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/tickets/create" method="POST" enctype="multipart/form-data">
                        <div class="modal-body d-flex flex-column gap-3 text-start">
                            <div>
                                <label class="form-label fw-semibold">Título</label>
                                <input name="title" class="form-control" required minlength="1"
                                    placeholder="Ej: Mochila negra">
                            </div>
                            <div>
                                <label class="form-label fw-semibold">Descripción detallada</label>
                                <textarea name="description" class="form-control" rows="3" required minlength="1"
                                    placeholder="Marca, contenido, dónde se perdió..."></textarea>
                            </div>


                            <div>
                                <label class="form-label fw-semibold">Foto del objeto (Opcional)</label>
                                <input name="image" type="file" class="form-control" accept="image/*">
                            </div>

                            <input name="status" value="5" hidden>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-success">Enviar Ticket</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>

</html>